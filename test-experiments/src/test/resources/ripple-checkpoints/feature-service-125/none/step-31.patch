@@ -0,0 +1,24 @@
+package com.sivalabs.ft.features.domain.models;
+
+import java.time.Instant;
+
+/**
+ * Optional filters for release queries. A {@code null} value means "do not filter on this attribute".
+ *
+ * <p>{@code startDate}/{@code endDate} are applied, inclusively, to the planned release date.
+ */
+public record ReleaseSearchCriteria(
+        String productCode, ReleaseStatus status, String releaseOwner, Instant startDate, Instant endDate) {
+
+    public static ReleaseSearchCriteria byStatus(ReleaseStatus status) {
+        return new ReleaseSearchCriteria(null, status, null, null, null);
+    }
+
+    public static ReleaseSearchCriteria byOwner(String releaseOwner) {
+        return new ReleaseSearchCriteria(null, null, releaseOwner, null, null);
+    }
+
+    public static ReleaseSearchCriteria byPlannedDateRange(Instant startDate, Instant endDate) {
+        return new ReleaseSearchCriteria(null, null, null, startDate, endDate);
+    }
+}
