diff --git a/src/main/java/com/sivalabs/ft/features/domain/ReleaseSpecifications.java b/src/main/java/com/sivalabs/ft/features/domain/ReleaseSpecifications.java
new file mode 100644
index 0000000..f005bb0
--- /dev/null
+++ b/src/main/java/com/sivalabs/ft/features/domain/ReleaseSpecifications.java
@@ -0,0 +1,61 @@
+package com.sivalabs.ft.features.domain;
+
+import com.sivalabs.ft.features.domain.entities.Release;
+import com.sivalabs.ft.features.domain.models.ReleaseSearchCriteria;
+import com.sivalabs.ft.features.domain.models.ReleaseStatus;
+import jakarta.persistence.criteria.CriteriaBuilder;
+import jakarta.persistence.criteria.Predicate;
+import jakarta.persistence.criteria.Root;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import org.springframework.data.jpa.domain.Specification;
+
+final class ReleaseSpecifications {
+
+    /** Statuses for which a planned release date can no longer be missed. */
+    private static final Set<ReleaseStatus> CLOSED_STATUSES = Set.of(ReleaseStatus.COMPLETED, ReleaseStatus.CANCELLED);
+
+    private ReleaseSpecifications() {}
+
+    static Specification<Release> matching(ReleaseSearchCriteria criteria) {
+        return (root, query, cb) -> {
+            List<Predicate> predicates = new ArrayList<>();
+            if (criteria.productCode() != null) {
+                predicates.add(cb.equal(root.get("product").get("code"), criteria.productCode()));
+            }
+            if (criteria.status() != null) {
+                predicates.add(cb.equal(root.get("status"), criteria.status()));
+            }
+            if (criteria.releaseOwner() != null) {
+                predicates.add(cb.equal(root.get("releaseOwner"), criteria.releaseOwner()));
+            }
+            if (criteria.startDate() != null) {
+                predicates.add(cb.greaterThanOrEqualTo(root.get("plannedReleaseDate"), criteria.startDate()));
+            }
+            if (criteria.endDate() != null) {
+                predicates.add(cb.lessThanOrEqualTo(root.get("plannedReleaseDate"), criteria.endDate()));
+            }
+            return cb.and(predicates.toArray(new Predicate[0]));
+        };
+    }
+
+    /**
+     * Releases whose planned release date has passed while the release is still open. Releases without a planned date
+     * are never overdue.
+     */
+    static Specification<Release> overdue(Instant now) {
+        return (root, query, cb) -> cb.and(cb.lessThan(root.get("plannedReleaseDate"), now), notClosed(root, cb));
+    }
+
+    /** Open releases whose planned release date falls within {@code [now, deadline]}. */
+    static Specification<Release> atRisk(Instant now, Instant deadline) {
+        return (root, query, cb) ->
+                cb.and(cb.between(root.get("plannedReleaseDate"), now, deadline), notClosed(root, cb));
+    }
+
+    private static Predicate notClosed(Root<Release> root, CriteriaBuilder cb) {
+        return cb.not(root.get("status").in(CLOSED_STATUSES));
+    }
+}
