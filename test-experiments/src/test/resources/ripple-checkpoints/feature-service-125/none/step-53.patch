+    /** Statuses for which a planned release date can no longer be missed. */
+    private static final Set<ReleaseStatus> CLOSED_STATUSES = Set.of(ReleaseStatus.COMPLETED, ReleaseStatus.CANCELLED);
+
+    private ReleaseSpecifications() {}
+
+    static Specification<Release> matching(ReleaseSearchCriteria criteria) {
+        return (root, query, cb) -> {
+            List<Predicate> predicates = new ArrayList<>();
+            if (criteria.productCode() != null) {
+                predicates.add(cb.equal(root.get("product").get("code"), criteria.productCode()));
+            }
+            if (criteria.status() != null) {
+                predicates.add(cb.equal(root.get("status"), criteria.status()));
+            }
+            if (criteria.releaseOwner() != null) {
+                predicates.add(cb.equal(root.get("releaseOwner"), criteria.releaseOwner()));
+            }
+            if (criteria.startDate() != null) {
+                predicates.add(cb.greaterThanOrEqualTo(root.get("plannedReleaseDate"), criteria.startDate()));
+            }
+            if (criteria.endDate() != null) {
+                predicates.add(cb.lessThanOrEqualTo(root.get("plannedReleaseDate"), criteria.endDate()));
+            }
+            return cb.and(predicates.toArray(new Predicate[0]));
+        };
+    }
+
+    /**
+     * Releases whose planned release date has passed while the release is still open. Releases without a planned date
+     * are never overdue.
+     */
+    static Specification<Release> overdue(Instant now) {
+        return (root, query, cb) -> cb.and(cb.lessThan(root.get("plannedReleaseDate"), now), notClosed(root, cb));
+    }
+
+    /** Open releases whose planned release date falls within {@code [now, deadline]}. */
+    static Specification<Release> atRisk(Instant now, Instant deadline) {
+        return (root, query, cb) ->
+                cb.and(cb.between(root.get("plannedReleaseDate"), now, deadline), notClosed(root, cb));
+    }
+
+    private static Predicate notClosed(Root<Release> root, CriteriaBuilder cb) {
+        return cb.not(root.get("status").in(CLOSED_STATUSES));
+    }
+}
diff --git a/src/main/java/com/sivalabs/ft/features/domain/ReleaseStatusTransitionValidator.java b/src/main/java/com/sivalabs/ft/features/domain/ReleaseStatusTransitionValidator.java
new file mode 100644
index 0000000..2f4f0cd
--- /dev/null
+++ b/src/main/java/com/sivalabs/ft/features/domain/ReleaseStatusTransitionValidator.java
@@ -0,0 +1,49 @@
+package com.sivalabs.ft.features.domain;
+
+import com.sivalabs.ft.features.domain.models.ReleaseStatus;
+import java.util.EnumMap;
+import java.util.Map;
+import java.util.Set;
+import org.springframework.stereotype.Component;
+
+/**
+ * State machine for {@link ReleaseStatus} transitions.
+ *
+ * <p>The happy path is {@code DRAFT -> PLANNED -> IN_PROGRESS -> COMPLETED}. A release can be cancelled from any
+ * non-terminal state and can be rolled back one step while it is still in progress. {@code COMPLETED} and
+ * {@code CANCELLED} are terminal states.
+ */
+@Component
+public class ReleaseStatusTransitionValidator {
+
+    private static final Map<ReleaseStatus, Set<ReleaseStatus>> ALLOWED_TRANSITIONS = new EnumMap<>(Map.of(
+            ReleaseStatus.DRAFT, Set.of(ReleaseStatus.PLANNED, ReleaseStatus.CANCELLED),
+            ReleaseStatus.PLANNED, Set.of(ReleaseStatus.IN_PROGRESS, ReleaseStatus.DRAFT, ReleaseStatus.CANCELLED),
+            ReleaseStatus.IN_PROGRESS, Set.of(ReleaseStatus.COMPLETED, ReleaseStatus.PLANNED, ReleaseStatus.CANCELLED),
+            ReleaseStatus.COMPLETED, Set.of(),
+            ReleaseStatus.CANCELLED, Set.of()));
+
+    /**
+     * @return {@code true} if the release may move from {@code currentStatus} to {@code newStatus}. Staying in the same
+     *     state is always allowed; {@code null} on either side is never allowed.
+     */
+    public boolean validateTransition(ReleaseStatus currentStatus, ReleaseStatus newStatus) {
+        if (currentStatus == null || newStatus == null) {
+            return false;
+        }
+        if (currentStatus == newStatus) {
+            return true;
+        }
+        return getValidNextStates(currentStatus).contains(newStatus);
+    }
+
+    /**
+     * @return the states reachable from {@code status}, or an empty set for terminal and {@code null} states.
+     */
+    public Set<ReleaseStatus> getValidNextStates(ReleaseStatus status) {
+        if (status == null) {
+            return Set.of();
+        }
+        return ALLOWED_TRANSITIONS.getOrDefault(status, Set.of());
+    }
+}
