index 0000000..a92044a
--- /dev/null
+++ b/src/main/resources/db/migration/V5__add_release_planning_columns.sql
@@ -0,0 +1,8 @@
+alter table releases
+    add column planned_release_date timestamp,
+    add column release_owner varchar(255),
+    add column release_version integer not null default 1;
+
+-- The legacy RELEASED status is replaced by the COMPLETED terminal state of the
+-- release planning state machine (DRAFT -> PLANNED -> IN_PROGRESS -> COMPLETED).
+update releases set status = 'COMPLETED' where status = 'RELEASED';