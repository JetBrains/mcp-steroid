@@ -0,0 +1,32 @@
+package com.sivalabs.ft.features.domain.exceptions;
+
+import com.sivalabs.ft.features.domain.models.ReleaseStatus;
+import java.util.Set;
+
+public class InvalidStatusTransitionException extends BadRequestException {
+
+    private final ReleaseStatus currentStatus;
+    private final ReleaseStatus newStatus;
+    private final Set<ReleaseStatus> validNextStates;
+
+    public InvalidStatusTransitionException(
+            ReleaseStatus currentStatus, ReleaseStatus newStatus, Set<ReleaseStatus> validNextStates) {
+        super("Invalid release status transition from %s to %s. Allowed transitions: %s"
+                .formatted(currentStatus, newStatus, validNextStates));
+        this.currentStatus = currentStatus;
+        this.newStatus = newStatus;
+        this.validNextStates = validNextStates == null ? Set.of() : Set.copyOf(validNextStates);
+    }
+
+    public ReleaseStatus getCurrentStatus() {
+        return currentStatus;
+    }
+
+    public ReleaseStatus getNewStatus() {
+        return newStatus;
+    }
+
+    public Set<ReleaseStatus> getValidNextStates() {
+        return validNextStates;
+    }
+}
