index 0000000..a4aace8
--- /dev/null
+++ b/src/main/java/com/sivalabs/ft/features/domain/ReleaseStatusTransitionValidator.java
@@ -0,0 +1,52 @@
+package com.sivalabs.ft.features.domain;
+
+import com.sivalabs.ft.features.domain.models.ReleaseStatus;
+import java.util.Map;
+import java.util.Set;
+import org.springframework.stereotype.Component;
+
+/**
+ * State machine defining the allowed {@link ReleaseStatus} transitions.
+ *
+ * <pre>
+ * DRAFT       -> PLANNED, CANCELLED
+ * PLANNED     -> IN_PROGRESS, DRAFT, CANCELLED
+ * IN_PROGRESS -> COMPLETED, PLANNED, CANCELLED
+ * COMPLETED   -> (terminal)
+ * CANCELLED   -> (terminal)
+ * </pre>
+ */
+@Component
+public class ReleaseStatusTransitionValidator {
+
+    private static final Map<ReleaseStatus, Set<ReleaseStatus>> ALLOWED_TRANSITIONS = Map.of(
+            ReleaseStatus.DRAFT, Set.of(ReleaseStatus.PLANNED, ReleaseStatus.CANCELLED),
+            ReleaseStatus.PLANNED,
+                    Set.of(ReleaseStatus.IN_PROGRESS, ReleaseStatus.DRAFT, ReleaseStatus.CANCELLED),
+            ReleaseStatus.IN_PROGRESS,
+                    Set.of(ReleaseStatus.COMPLETED, ReleaseStatus.PLANNED, ReleaseStatus.CANCELLED),
+            ReleaseStatus.COMPLETED, Set.of(),
+            ReleaseStatus.CANCELLED, Set.of());
+
+    /**
+     * Returns true when a release can move from {@code currentStatus} to {@code newStatus}.
+     * Staying in the same status is always allowed, null statuses are never allowed.
+     */
+    public boolean validateTransition(ReleaseStatus currentStatus, ReleaseStatus newStatus) {
+        if (currentStatus == null || newStatus == null) {
+            return false;
+        }
+        if (currentStatus == newStatus) {
+            return true;
+        }
+        return getValidNextStates(currentStatus).contains(newStatus);
+    }
+
+    /** Returns the statuses reachable from the given status, empty for terminal or unknown statuses. */
+    public Set<ReleaseStatus> getValidNextStates(ReleaseStatus status) {
+        if (status == null) {
+            return Set.of();
+        }
+        return ALLOWED_TRANSITIONS.getOrDefault(status, Set.of());
+    }
+}
