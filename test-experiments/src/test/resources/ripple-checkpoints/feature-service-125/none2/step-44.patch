@@ -0,0 +1,39 @@
+package com.sivalabs.ft.features.domain;
+
+import com.sivalabs.ft.features.domain.models.ReleaseStatus;
+import java.util.Map;
+import java.util.Set;
+import org.springframework.stereotype.Component;
+
+/**
+ * State machine describing which {@link ReleaseStatus} transitions are allowed.
+ * COMPLETED and CANCELLED are terminal states.
+ */
+@Component
+public class ReleaseStatusTransitionValidator {
+
+    private static final Map<ReleaseStatus, Set<ReleaseStatus>> ALLOWED_TRANSITIONS = Map.of(
+            ReleaseStatus.DRAFT, Set.of(ReleaseStatus.PLANNED, ReleaseStatus.CANCELLED),
+            ReleaseStatus.PLANNED, Set.of(ReleaseStatus.IN_PROGRESS, ReleaseStatus.DRAFT, ReleaseStatus.CANCELLED),
+            ReleaseStatus.IN_PROGRESS,
+                    Set.of(ReleaseStatus.COMPLETED, ReleaseStatus.PLANNED, ReleaseStatus.CANCELLED),
+            ReleaseStatus.COMPLETED, Set.of(),
+            ReleaseStatus.CANCELLED, Set.of());
+
+    public boolean validateTransition(ReleaseStatus currentStatus, ReleaseStatus newStatus) {
+        if (currentStatus == null || newStatus == null) {
+            return false;
+        }
+        if (currentStatus == newStatus) {
+            return true;
+        }
+        return getValidNextStates(currentStatus).contains(newStatus);
+    }
+
+    public Set<ReleaseStatus> getValidNextStates(ReleaseStatus status) {
+        if (status == null) {
+            return Set.of();
+        }
+        return ALLOWED_TRANSITIONS.getOrDefault(status, Set.of());
+    }
+}
