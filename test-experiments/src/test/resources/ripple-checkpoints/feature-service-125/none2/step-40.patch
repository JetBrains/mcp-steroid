@@ -0,0 +1,35 @@
+package com.sivalabs.ft.features.domain;
+
+import com.sivalabs.ft.features.domain.entities.Release;
+import com.sivalabs.ft.features.domain.models.ReleaseStatus;
+import jakarta.persistence.criteria.Predicate;
+import java.time.Instant;
+import java.util.ArrayList;
+import org.springframework.data.jpa.domain.Specification;
+
+final class ReleaseSpecifications {
+    private ReleaseSpecifications() {}
+
+    static Specification<Release> filterBy(
+            String productCode, ReleaseStatus status, String releaseOwner, Instant startDate, Instant endDate) {
+        return (root, query, cb) -> {
+            var predicates = new ArrayList<Predicate>();
+            if (productCode != null && !productCode.isBlank()) {
+                predicates.add(cb.equal(root.get("product").get("code"), productCode));
+            }
+            if (status != null) {
+                predicates.add(cb.equal(root.get("status"), status));
+            }
+            if (releaseOwner != null && !releaseOwner.isBlank()) {
+                predicates.add(cb.equal(root.get("releaseOwner"), releaseOwner));
+            }
+            if (startDate != null) {
+                predicates.add(cb.greaterThanOrEqualTo(root.get("plannedReleaseDate"), startDate));
+            }
+            if (endDate != null) {
+                predicates.add(cb.lessThanOrEqualTo(root.get("plannedReleaseDate"), endDate));
+            }
+            return cb.and(predicates.toArray(new Predicate[0]));
+        };
+    }
+}
diff --git a/src/main/java/com/sivalabs/ft/features/domain/ReleaseStatusTransitionValidator.java b/src/main/java/com/sivalabs/ft/features/domain/ReleaseStatusTransitionValidator.java
