+    /**
+     * Finds the features of the given release and of all its ancestor releases.
+     * When {@code fromParentRelease} is given, the traversal stops at that ancestor release.
+     */
+    @Query(
+            value =
+                    """
+                    with recursive release_tree as (
+                        select r.id, r.parent_id, r.code
+                        from releases r
+                        where r.code = :releaseCode
+                        union all
+                        select p.id, p.parent_id, p.code
+                        from releases p
+                        join release_tree rt on p.id = rt.parent_id
+                        where cast(:fromParentRelease as varchar) is null
+                           or rt.code <> cast(:fromParentRelease as varchar)
+                    )
+                    select f.* from features f join release_tree rt on f.release_id = rt.id
+                    """,
+            nativeQuery = true)
+    List<Feature> findByReleaseCodeAndParents(String releaseCode, String fromParentRelease);
+
     @Modifying
     void deleteByCode(String code);
 
