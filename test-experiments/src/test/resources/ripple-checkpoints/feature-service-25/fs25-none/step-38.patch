+    /**
+     * Resolves the parent release referenced by {@code parentCode}.
+     * A null or empty parentCode means "no parent".
+     */
+    private Release resolveParent(String releaseCode, String parentCode) {
+        if (parentCode == null || parentCode.isBlank()) {
+            return null;
+        }
+        if (parentCode.equals(releaseCode)) {
+            throw new BadRequestException("Release with code " + releaseCode + " cannot be its own parent");
+        }
+        return releaseRepository
+                .findByCode(parentCode)
+                .orElseThrow(() ->
+                        new ResourceNotFoundException("Parent release with code " + parentCode + " not found"));
+    }
 }
