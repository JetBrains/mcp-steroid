+package eval.sample.auth;
+
+import java.util.Set;
+
+/**
+ * Application user. Roles are stored without the {@code ROLE_} prefix (e.g. {@code USER}, {@code ADMIN}).
+ */
+public record User(long id, String username, String password, Set<String> roles) {
+
+    public User(long id, String username, String password, Set<String> roles) {
+        this.id = id;
+        this.username = username;
+        this.password = password;
+        this.roles = Set.copyOf(roles);
+    }
+}