+package eval.sample.auth;
+
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.stereotype.Repository;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+
+/**
+ * In-memory store of the predefined users. Passwords are encoded on startup, never kept in clear text.
+ */
+@Repository
+public class UserRepository {
+
+    private final Map<String, User> usersByUsername;
+
+    public UserRepository(PasswordEncoder passwordEncoder) {
+        this.usersByUsername = List.of(
+                        new User(1L, "admin", passwordEncoder.encode("admin123"), Set.of("USER", "ADMIN")),
+                        new User(2L, "user", passwordEncoder.encode("user123"), Set.of("USER")))
+                .stream()
+                .collect(Collectors.toUnmodifiableMap(User::username, Function.identity()));
+    }
+
+    public Optional<User> findByUsername(String username) {
+        return Optional.ofNullable(usersByUsername.get(username));
+    }
+}