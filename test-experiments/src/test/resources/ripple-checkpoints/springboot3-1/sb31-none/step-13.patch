+package eval.sample.security;
+
+/**
+ * Successful authentication payload returned by {@code POST /api/auth/login}.
+ */
+public record JwtAuthenticationResponse(String tokenType, String token, String username) {
+
+    public static JwtAuthenticationResponse bearer(String token, String username) {
+        return new JwtAuthenticationResponse("Bearer", token, username);
+    }
+}
