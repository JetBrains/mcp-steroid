+    @PreAuthorize("hasRole(@roles.OWNER_ADMIN)")
+    @GetMapping(value = "pets/pages", produces = MediaType.APPLICATION_JSON_VALUE)
+    public ResponseEntity<Page<PetDto>> listPetsPaginated(Pageable pageable) {
+        List<PetDto> pets = new ArrayList<>(petMapper.toPetsDto(this.clinicService.findAllPets()));
+        if (pets.isEmpty()) {
+            return new ResponseEntity<>(HttpStatus.NOT_FOUND);
+        }
+        int start = (int) Math.min(pageable.getOffset(), pets.size());
+        int end = Math.min(start + pageable.getPageSize(), pets.size());
+        List<PetDto> pageContent = start >= end ? Collections.emptyList() : pets.subList(start, end);
+        return new ResponseEntity<>(new PageImpl<>(pageContent, pageable, pets.size()), HttpStatus.OK);
+    }
