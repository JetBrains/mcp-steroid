+    @SuppressWarnings("unchecked")
+    private static <T> T newProxy(Class<T> type, InvocationHandler handler) {
+        return (T) Proxy.newProxyInstance(
+                ClientAuthenticationMethodResidualContractTest.class.getClassLoader(),
+                new Class<?>[]{type}, handler);
+    }
+
+    private abstract static class DefaultingHandler implements InvocationHandler {
+
+        static final Object NOT_HANDLED = new Object();
+
+        @Override
+        public final Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
+            String name = method.getName();
+            if ("toString".equals(name) && (args == null || args.length == 0)) {
+                return getClass().getSimpleName() + "@" + Integer.toHexString(System.identityHashCode(proxy));
+            }
+            if ("hashCode".equals(name) && (args == null || args.length == 0)) {
+                return System.identityHashCode(proxy);
+            }
+            if ("equals".equals(name) && args != null && args.length == 1) {
+                return proxy == args[0];
+            }
+            Object answer = answer(proxy, method, args);
+            return answer == NOT_HANDLED ? defaultValue(method.getReturnType()) : answer;
+        }
+
+        abstract Object answer(Object proxy, Method method, Object[] args) throws Throwable;
+
+        private static Object defaultValue(Class<?> type) {
+            if (type.isPrimitive()) {
+                if (type == boolean.class) {
+                    return Boolean.FALSE;
+                }
+                if (type == char.class) {
+                    return (char) 0;
+                }
+                if (type == byte.class) {
+                    return (byte) 0;
+                }
+                if (type == short.class) {
+                    return (short) 0;
+                }
+                if (type == int.class) {
+                    return 0;
+                }
+                if (type == long.class) {
+                    return 0L;
+                }
+                if (type == float.class) {
+                    return 0F;
+                }
+                if (type == double.class) {
+                    return 0D;
+                }
+                return null;
+            }
+            if (Stream.class.isAssignableFrom(type)) {
+                return Stream.empty();
+            }
+            if (Optional.class.isAssignableFrom(type)) {
+                return Optional.empty();
+            }
+            if (MultivaluedMap.class.isAssignableFrom(type)) {
+                return new MultivaluedHashMap<String, String>();
+            }
+            if (Map.class.isAssignableFrom(type)) {
+                return new HashMap<>();
+            }
+            if (Set.class.isAssignableFrom(type)) {
+                return new LinkedHashSet<>();
+            }
+            if (List.class.isAssignableFrom(type)) {
+                return new ArrayList<>();
+            }
+            return null;
+        }
+    }
