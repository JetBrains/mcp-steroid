+    private static List<String> duplicates(List<String> values) {
+        Set<String> seen = new LinkedHashSet<>();
+        Set<String> repeated = new LinkedHashSet<>();
+        for (String value : values) {
+            if (!seen.add(value)) {
+                repeated.add(value);
+            }
+        }
+        return new ArrayList<>(repeated);
+    }
