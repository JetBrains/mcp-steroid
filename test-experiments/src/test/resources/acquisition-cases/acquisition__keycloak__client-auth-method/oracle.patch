+    /**
+     * B1 - a client presenting exactly the certificate registered for it is authenticated.
+     * <p>
+     * The certificate is self-issued and the session offers no truststore whatsoever, so passing this axis
+     * also demonstrates that no certificate authority and no trust anchor is consulted: an implementation
+     * that copies the shipped certificate-authority validation of the sibling authenticator cannot reach
+     * {@code success} here.
+     */
+    @Test
+    public void aClientPresentingItsRegisteredCertificateIsAuthenticated() {
+        CertificateFixture fixture = certificates();
+
+        Outcome outcome = authenticate(new X509Certificate[]{fixture.registered}, fixture.registeredPem);
+
+        Assert.assertEquals("A client presenting exactly the certificate registered for it has to be"
+                        + " authenticated, without any certificate authority being consulted"
+                        + outcome.describe(),
+                FlowStatus.SUCCESS, outcome.status);
+        Assert.assertNotNull("The authenticated client has to be attached to the flow", outcome.client);
+    }
+
+    /**
+     * B2 - THE INVARIANT. A freshly re-issued certificate carrying the very same subject name and the very
+     * same public key as the registered one, but different bytes, is refused.
+     * <p>
+     * This is the axis a naive copy of the shipped certificate-based authenticator breaks: that one compares
+     * the subject distinguished name, which is identical here. The new method has to accept on identity of
+     * the certificate itself, never on a name or a key.
+     */
+    @Test
+    public void aReIssuedCertificateWithTheSameSubjectAndKeyIsRefused() {
+        CertificateFixture fixture = certificates();
+
+        Assert.assertEquals("fixture: the re-issued certificate must carry the same subject",
+                fixture.registered.getSubjectX500Principal(), fixture.reIssued.getSubjectX500Principal());
+        Assert.assertEquals("fixture: the re-issued certificate must carry the same public key",
+                fixture.registered.getPublicKey(), fixture.reIssued.getPublicKey());
+
+        Outcome outcome = authenticate(new X509Certificate[]{fixture.reIssued}, fixture.registeredPem);
+
+        Assert.assertNotEquals("A re-issued certificate with the same subject name and the same key is NOT"
+                        + " the registered certificate and has to be refused; comparing the subject"
+                        + " distinguished name, as the shipped certificate-authority based method does,"
+                        + " accepts it" + outcome.describe(),
+                FlowStatus.SUCCESS, outcome.status);
+    }
+
+    /**
+     * B3 - a valid but unrelated certificate, issued to a different subject with a different key, is refused.
+     */
+    @Test
+    public void aCertificateThatIsNotTheRegisteredOneIsRefused() {
+        CertificateFixture fixture = certificates();
+
+        Outcome outcome = authenticate(new X509Certificate[]{fixture.foreign}, fixture.registeredPem);
+
+        Assert.assertNotEquals("A certificate that is not the one registered for the client has to be"
+                        + " refused" + outcome.describe(),
+                FlowStatus.SUCCESS, outcome.status);
+    }
+
+    /**
+     * B4 - a request that carries no client certificate at all leaves the execution to the rest of the flow.
+     * <p>
+     * Client authentication is a flow of alternative executions, so an authenticator that cannot say anything
+     * has to mark the execution as merely attempted. Aborting the flow instead would make every client of the
+     * realm unable to authenticate by any other means as soon as this authenticator is enabled.
+     */
+    @Test
+    public void aRequestWithoutAClientCertificateLeavesTheFlowToOtherExecutions() {
+        CertificateFixture fixture = certificates();
+
+        Outcome outcome = authenticate(new X509Certificate[0], fixture.registeredPem);
+
+        Assert.assertEquals("A request without a client certificate has to leave the execution attempted so"
+                        + " that the remaining alternative executions still get their chance"
+                        + outcome.describe(),
+                FlowStatus.ATTEMPTED, outcome.status);
+    }
+
+    // ----------------------------------------------------------------------------------------------------
+    // the authenticator under test - built the way the runtime builds it
+    // ----------------------------------------------------------------------------------------------------
+
+    /**
+     * Runs the authenticator under test against a request that presents {@code presentedChain} over mutual
+     * TLS for a client that has {@code registeredCertificatePem} registered.
+     */
+    private static Outcome authenticate(X509Certificate[] presentedChain, String registeredCertificatePem) {
+        Map<String, String> clientAttributes = new HashMap<>();
+        if (registeredCertificatePem != null) {
+            clientAttributes.put(JWTClientAuthenticator.CERTIFICATE_ATTR, registeredCertificatePem);
+        }
+
+        ClientModel client = newProxy(ClientModel.class, new ClientHandler(clientAttributes));
+        RealmModel realm = newProxy(RealmModel.class, new RealmHandler(client));
+        UriInfo uriInfo = newProxy(UriInfo.class, new UriInfoHandler());
+        HttpRequest httpRequest = newProxy(HttpRequest.class, new HttpRequestHandler(presentedChain, uriInfo));
+        ContextOfSessionHandler contextHandler = new ContextOfSessionHandler(realm, httpRequest);
+        KeycloakContext context = newProxy(KeycloakContext.class, contextHandler);
+        KeycloakSession session = newProxy(KeycloakSession.class,
+                new SessionHandler(context, presentedChain));
+        // KeycloakContext.getUri() is typed to a concrete class, so the real one is built here, over a
+        // delegate that answers the empty query string of a form-encoded token request
+        contextHandler.uri = new KeycloakUriInfo(session, UrlType.FRONTEND, uriInfo);
+
+        Outcome outcome = new Outcome();
+        EventBuilder event = new EventBuilder(realm, session);
+        ClientAuthenticationFlowContext flowContext = newProxy(ClientAuthenticationFlowContext.class,
+                new FlowContextHandler(outcome, session, realm, httpRequest, uriInfo, event));
+
+        authenticatorUnderTest(session).authenticateClient(flowContext);
+        return outcome;
+    }
+
+    /**
+     * The authenticator as the runtime hands it to the client authentication flow: discovered by
+     * name-independent means and, when the discovered class is its own factory, obtained through
+     * {@code create(session)} exactly as the flow does. Never returns an object the runtime could not build.
+     */
+    private static ClientAuthenticator authenticatorUnderTest(KeycloakSession session) {
+        List<Class<?>> discovered = newAuthenticatorClasses();
+        if (discovered.size() == 1) {
+            return asProvider(instantiate(discovered.get(0)), session);
+        }
+
+        ClientAuthenticator fromSpi = authenticatorFromSpi(session);
+        if (discovered.isEmpty()) {
+            if (fromSpi != null) {
+                return fromSpi;
+            }
+            Assert.fail("No new " + ClientAuthenticator.class.getSimpleName() + " was found: neither a new"
+                    + " implementation compiled under " + SCANNED_PACKAGE + " nor a new provider id"
+                    + " registered through the SPI. The behaviour under test is not implemented.");
+        }
+        if (fromSpi != null && discovered.contains(fromSpi.getClass())) {
+            return fromSpi;
+        }
+        Assert.fail("Expected exactly one new " + ClientAuthenticator.class.getSimpleName()
+                + " implementation, but found " + classNames(discovered)
+                + " and no registered factory that singles one of them out");
+        throw new AssertionError("unreachable");
+    }
+
+    private static ClientAuthenticator asProvider(Object instance, KeycloakSession session) {
+        if (instance instanceof ClientAuthenticatorFactory) {
+            ClientAuthenticator provider = ((ClientAuthenticatorFactory) instance).create(session);
+            if (provider != null) {
+                return provider;
+            }
+        }
+        if (instance instanceof ClientAuthenticator) {
+            return (ClientAuthenticator) instance;
+        }
+        Assert.fail("The discovered implementation '" + instance.getClass().getName() + "' produced no "
+                + ClientAuthenticator.class.getSimpleName());
+        throw new AssertionError("unreachable");
+    }
+
+    private static ClientAuthenticator authenticatorFromSpi(KeycloakSession session) {
+        try {
+            List<String> newIds = newFactoryIds();
+            if (newIds.size() != 1) {
+                return null;
+            }
+            ClientAuthenticatorFactory factory = clientAuthenticatorFactory(newIds.get(0));
+            return factory == null ? null : factory.create(session);
+        } catch (Exception e) {
+            System.err.println("Cannot build the client authenticator through the provider SPI: " + e);
+            return null;
+        }
+    }
+
+    private static Object instantiate(Class<?> type) {
+        Object instance = newInstanceOrNull(type);
+        if (instance == null) {
+            Assert.fail("The discovered client authenticator '" + type.getName() + "' offers no public"
+                    + " no-arg constructor, so the provider SPI could never instantiate it either");
+        }
+        return instance;
+    }
+
+    private static Object newInstanceOrNull(Class<?> type) {
+        for (Constructor<?> constructor : type.getConstructors()) {
+            if (constructor.getParameterCount() == 0) {
+                try {
+                    return constructor.newInstance();
+                } catch (Throwable t) {
+                    System.err.println("Cannot instantiate '" + type.getName() + "': " + t);
+                    return null;
+                }
+            }
+        }
+        return null;
+    }
+
+    // ----------------------------------------------------------------------------------------------------
+    // discovery route (1) - the compiled classes of this module
+    // ----------------------------------------------------------------------------------------------------
+
+    private static List<Class<?>> newAuthenticatorClasses() {
+        List<Class<?>> discovered = new ArrayList<>();
+        for (String name : compiledClassNames()) {
+            if (BASELINE_AUTHENTICATOR_CLASS_NAMES.contains(name)) {
+                continue;
+            }
+            Class<?> candidate = loadOrNull(name);
+            if (candidate != null && isConcreteAuthenticator(candidate)) {
+                discovered.add(candidate);
+            }
+        }
+        return discovered;
+    }
+
+    private static boolean isCompiledAuthenticator(String name) {
+        Class<?> candidate = loadOrNull(name);
+        return candidate != null && isConcreteAuthenticator(candidate);
+    }
+
+    private static boolean isConcreteAuthenticator(Class<?> candidate) {
+        try {
+            return ClientAuthenticator.class.isAssignableFrom(candidate)
+                    && !candidate.isInterface()
+                    && !Modifier.isAbstract(candidate.getModifiers())
+                    && !candidate.isSynthetic()
+                    && !candidate.isAnonymousClass()
+                    && !candidate.isLocalClass();
+        } catch (Throwable t) {
+            System.err.println("Skipping class '" + candidate.getName() + "' which cannot be inspected: " + t);
+            return false;
+        }
+    }
+
+    private static Class<?> loadOrNull(String name) {
+        try {
+            return Class.forName(name, false,
+                    ClientAuthenticationMethodResidualContractTest.class.getClassLoader());
+        } catch (Throwable t) {
+            // an unloadable class must not abort the scan - it simply cannot be the authenticator under test
+            System.err.println("Skipping class '" + name + "' which cannot be loaded: " + t);
+            return null;
+        }
+    }
+
+    private static List<String> compiledClassNames() {
+        URL location = X509ClientAuthenticator.class.getProtectionDomain().getCodeSource().getLocation();
+        Assert.assertNotNull("Cannot locate the compiled classes of this module", location);
+
+        List<String> names = new ArrayList<>();
+        try {
+            Path root = Paths.get(location.toURI());
+            if (Files.isDirectory(root)) {
+                Path scanned = root.resolve(SCANNED_PACKAGE);
+                if (Files.isDirectory(scanned)) {
+                    try (Stream<Path> paths = Files.walk(scanned)) {
+                        names.addAll(paths
+                                .filter(path -> path.getFileName().toString().endsWith(CLASS_SUFFIX))
+                                .map(path -> toClassName(
+                                        root.relativize(path).toString().replace(File.separatorChar, '/')))
+                                .collect(Collectors.toList()));
+                    }
+                }
+            } else {
+                try (JarFile jar = new JarFile(root.toFile())) {
+                    Enumeration<JarEntry> entries = jar.entries();
+                    while (entries.hasMoreElements()) {
+                        String entry = entries.nextElement().getName();
+                        if (entry.startsWith(SCANNED_PACKAGE + "/") && entry.endsWith(CLASS_SUFFIX)) {
+                            names.add(toClassName(entry));
+                        }
+                    }
+                }
+            }
+        } catch (Exception e) {
+            Assert.fail("Cannot scan the compiled classes at '" + location + "': " + e);
+        }
+        Collections.sort(names);
+        return names;
+    }
+
+    private static String toClassName(String resourcePath) {
+        return resourcePath.substring(0, resourcePath.length() - CLASS_SUFFIX.length()).replace('/', '.');
+    }
+
+    // ----------------------------------------------------------------------------------------------------
+    // discovery route (2) - the provider SPI
+    // ----------------------------------------------------------------------------------------------------
+
+    private static List<String> newFactoryIds() {
+        return allFactoryIds().stream()
+                .filter(id -> !BASELINE_FACTORY_IDS.contains(id))
+                .sorted()
+                .collect(Collectors.toList());
+    }
+
+    private static Set<String> allFactoryIds() {
+        return registeredFactories().stream()
+                .map(ProviderFactory::getId)
+                .collect(Collectors.toCollection(LinkedHashSet::new));
+    }
+
+    private static List<ClientAuthenticatorFactory> registeredFactories() {
+        return serverSession().getKeycloakSessionFactory()
+                .getProviderFactoriesStream(ClientAuthenticator.class)
+                .filter(ClientAuthenticatorFactory.class::isInstance)
+                .map(ClientAuthenticatorFactory.class::cast)
+                .collect(Collectors.toList());
+    }
+
+    private static ClientAuthenticatorFactory clientAuthenticatorFactory(String id) {
+        ProviderFactory<ClientAuthenticator> factory = serverSession().getKeycloakSessionFactory()
+                .getProviderFactory(ClientAuthenticator.class, id);
+        return factory instanceof ClientAuthenticatorFactory ? (ClientAuthenticatorFactory) factory : null;
+    }
+
+    /**
+     * The list of OIDC token-endpoint authentication methods a realm's discovery document would publish: a
+     * flat map over every client authenticator factory, deliberately not de-duplicated. Newly compiled
+     * authenticators that are not registered yet are added too, so this axis does not depend on the
+     * ServiceLoader registration having been done.
+     */
+    private static List<String> publishedOidcClientAuthMethods() {
+        List<ClientAuthenticatorFactory> factories = new ArrayList<>(registeredFactories());
+        Set<Class<?>> known = factories.stream().map(Object::getClass).collect(Collectors.toSet());
+        for (Class<?> candidate : newAuthenticatorClasses()) {
+            if (known.contains(candidate)) {
+                continue;
+            }
+            Object instance = newInstanceOrNull(candidate);
+            if (instance instanceof ClientAuthenticatorFactory) {
+                factories.add((ClientAuthenticatorFactory) instance);
+            }
+        }
+
+        List<String> methods = new ArrayList<>();
+        for (ClientAuthenticatorFactory factory : factories) {
+            Set<String> claimed;
+            try {
+                claimed = factory.getProtocolAuthenticatorMethods(OIDCLoginProtocol.LOGIN_PROTOCOL);
+            } catch (Exception e) {
+                System.err.println("Factory '" + factory.getClass().getName()
+                        + "' failed to answer which OIDC methods it claims: " + e);
+                continue;
+            }
+            if (claimed != null) {
+                methods.addAll(claimed);
+            }
+        }
+        return methods;
+    }
+
+    private static synchronized KeycloakSession serverSession() {
+        if (serverSession == null) {
+            try {
+                Profile.defaults();
+                CryptoIntegration.init(CryptoProvider.class.getClassLoader());
+                ResteasyKeycloakSessionFactory sessionFactory = new ResteasyKeycloakSessionFactory();
+                sessionFactory.init();
+                serverSession = new ResteasyKeycloakSession(sessionFactory);
+            } catch (Exception e) {
+                Assert.fail("Cannot boot a provider registry to resolve client authenticator factories: " + e);
+            }
+        }
+        return serverSession;
+    }
