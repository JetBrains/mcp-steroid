+
+    private static Map<String, List<String>> allowedClientAuthenticatorsByProfile() throws IOException {
+        Map<String, List<String>> allowed = new LinkedHashMap<>();
+        forEachSecureClientAuthenticatorExecutor((profile, configuration) -> {
+            JsonNode list = configuration.get(ALLOWED_CLIENT_AUTHENTICATORS);
+            List<String> ids = new ArrayList<>();
+            if (list != null) {
+                for (JsonNode id : list) {
+                    ids.add(id.asText());
+                }
+            }
+            allowed.put(profile, ids);
+        });
+        return allowed;
+    }
+
+    private static Map<String, String> defaultClientAuthenticatorByProfile() throws IOException {
+        Map<String, String> defaults = new LinkedHashMap<>();
+        forEachSecureClientAuthenticatorExecutor((profile, configuration) -> {
+            JsonNode value = configuration.get(DEFAULT_CLIENT_AUTHENTICATOR);
+            defaults.put(profile, value == null ? null : value.asText());
+        });
+        return defaults;
+    }
+
+    private static void forEachSecureClientAuthenticatorExecutor(ExecutorVisitor visitor) throws IOException {
+        for (JsonNode profile : readDefaultProfiles().get("profiles")) {
+            JsonNode executors = profile.get("executors");
+            if (executors == null) {
+                continue;
+            }
+            for (JsonNode executor : executors) {
+                JsonNode id = executor.get("executor");
+                if (id == null || !SECURE_CLIENT_AUTHENTICATOR_EXECUTOR.equals(id.asText())) {
+                    continue;
+                }
+                JsonNode configuration = executor.get("configuration");
+                if (configuration != null) {
+                    visitor.visit(profile.get("name").asText(), configuration);
+                }
+            }
+        }
+    }
+
+    private static JsonNode readDefaultProfiles() throws IOException {
+        try (InputStream is = ClientAuthenticationMethodResidualContractTest.class.getClassLoader()
+                .getResourceAsStream(DEFAULT_PROFILES_RESOURCE)) {
+            Assert.assertNotNull("Classpath resource '" + DEFAULT_PROFILES_RESOURCE + "' is missing", is);
+            return JsonSerialization.mapper.readTree(is);
+        }
+    }
+
+    private interface ExecutorVisitor {
+        void visit(String profile, JsonNode configuration);
+    }
