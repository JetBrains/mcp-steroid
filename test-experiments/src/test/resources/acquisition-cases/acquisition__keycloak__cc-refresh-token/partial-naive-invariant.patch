+package org.keycloak.services.clientpolicy.executor;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import org.keycloak.events.Errors;
+import org.keycloak.models.ClientModel;
+import org.keycloak.protocol.oidc.OIDCConfigAttributes;
+import org.keycloak.representations.idm.ClientPolicyExecutorConfigurationRepresentation;
+import org.keycloak.representations.idm.ClientRepresentation;
+import org.keycloak.services.clientpolicy.ClientPolicyContext;
+import org.keycloak.services.clientpolicy.ClientPolicyException;
+import org.keycloak.services.clientpolicy.context.ClientCRUDContext;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+
+/**
+ * Rejects clients which are configured to issue a refresh token for the client credentials grant.
+ */
+public class RejectClientCredentialsRefreshTokenExecutor implements ClientPolicyExecutorProvider<RejectClientCredentialsRefreshTokenExecutor.Configuration> {
+
+    private static final String ATTRIBUTE = OIDCConfigAttributes.USE_REFRESH_TOKEN_FOR_CLIENT_CREDENTIALS_GRANT;
+
+    private Configuration configuration;
+
+    @Override
+    public void executeOnEvent(ClientPolicyContext context) throws ClientPolicyException {
+        ClientCRUDContext clientUpdateContext = null;
+        switch (context.getEvent()) {
+            case REGISTER:
+                clientUpdateContext = (ClientCRUDContext)context;
+                autoConfigure(clientUpdateContext.getProposedClientRepresentation());
+                validate(getProposedValue(clientUpdateContext.getProposedClientRepresentation()));
+                break;
+            case UPDATE:
+                clientUpdateContext = (ClientCRUDContext)context;
+                beforeUpdate(clientUpdateContext.getTargetClient(), clientUpdateContext.getProposedClientRepresentation());
+                break;
+            default:
+                return;
+        }
+    }
+
+    @Override
+    public void setupConfiguration(Configuration config) {
+        this.configuration = config;
+    }
+
+    @Override
+    public Class<Configuration> getExecutorConfigurationClass() {
+        return Configuration.class;
+    }
+
+    public static class Configuration extends ClientPolicyExecutorConfigurationRepresentation {
+        @JsonProperty("auto-configure")
+        protected Boolean autoConfigure;
+
+        public Boolean isAutoConfigure() {
+            return autoConfigure;
+        }
+
+        public void setAutoConfigure(Boolean autoConfigure) {
+            this.autoConfigure = autoConfigure;
+        }
+    }
+
+    @Override
+    public String getProviderId() {
+        return RejectClientCredentialsRefreshTokenExecutorFactory.PROVIDER_ID;
+    }
+
+    private boolean isAutoConfigure() {
+        return configuration != null && configuration.isAutoConfigure() != null && configuration.isAutoConfigure();
+    }
+
+    private void autoConfigure(ClientRepresentation proposedClient) {
+        if (!isAutoConfigure() || proposedClient == null) {
+            return;
+        }
+        if (getProposedValue(proposedClient) != null) {
+            return;
+        }
+        Map<String, String> attributes = proposedClient.getAttributes();
+        if (attributes == null) {
+            attributes = new HashMap<>();
+            proposedClient.setAttributes(attributes);
+        }
+        attributes.put(ATTRIBUTE, Boolean.FALSE.toString());
+    }
+
+    private void validate(String value) throws ClientPolicyException {
+        if (Boolean.parseBoolean(value)) {
+            throw new ClientPolicyException(Errors.INVALID_REGISTRATION,
+                    "Invalid client metadata: refresh token for the client credentials grant is prohibited");
+        }
+    }
+
+    public void beforeUpdate(ClientModel clientToBeUpdated, ClientRepresentation proposedClient) throws ClientPolicyException {
+        validate(getProposedValue(proposedClient));
+    }
+
+    private static String getProposedValue(ClientRepresentation proposedClient) {
+        if (proposedClient == null || proposedClient.getAttributes() == null) {
+            return null;
+        }
+        return proposedClient.getAttributes().get(ATTRIBUTE);
+    }
+
+}
