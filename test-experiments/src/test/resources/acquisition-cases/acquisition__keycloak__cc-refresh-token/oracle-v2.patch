+    /**
+     * A6 - registering a client that says nothing about the setting auto-configures it off.
+     * <p>
+     * The {@code auto-configure} switch is fed through the executor's own configuration type, exactly as the
+     * shipped profile feeds it. Should an implementation declare no configuration type of its own, the switch
+     * is not expressible at all - in that case the only honest reading of "turns it off" is that the executor
+     * auto-configures unconditionally, so the same {@code "false"} expectation is kept and the message says
+     * why. Either way the axis stays non-trivial: merely not throwing is never enough to pass it.
+     */
+    @Test
+    public void registerWithoutTheSettingTurnsItOff() throws ClientPolicyException {
+        ClientPolicyExecutorProvider executor = executorUnderTest();
+        boolean autoConfigureExpressible = autoConfigureIsExpressible(executor);
+
+        ClientRepresentation proposed = clientRepresentation(null);
+        executor.executeOnEvent(new CRUDContext(ClientPolicyEvent.REGISTER, proposed, null));
+
+        String because = autoConfigureExpressible
+                ? " (the executor was configured with '" + AUTO_CONFIGURE + "': true)"
+                : " (the executor exposes no '" + AUTO_CONFIGURE + "' configuration, so it must auto-configure"
+                        + " unconditionally)";
+        Assert.assertNotNull("The executor is expected to auto-configure the client attributes" + because,
+                proposed.getAttributes());
+        Assert.assertEquals("The executor is expected to turn '" + ATTRIBUTE_KEY + "' off on registration" + because,
+                "false", proposed.getAttributes().get(ATTRIBUTE_KEY));
+    }
