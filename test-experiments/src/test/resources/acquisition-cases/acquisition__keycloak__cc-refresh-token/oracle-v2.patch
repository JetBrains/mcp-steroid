+    /**
+     * A {@link ClientModel} that only knows about {@link #ATTRIBUTE_KEY}, everything else answers with the
+     * neutral default of the return type.
+     */
+    private static ClientModel clientWithAttribute(String value) {
+        return (ClientModel) Proxy.newProxyInstance(
+                ClientCredentialsRefreshTokenResidualContractTest.class.getClassLoader(),
+                new Class<?>[]{ClientModel.class},
+                new AttributeOnlyClient(value));
+    }
+
+    private static class AttributeOnlyClient implements InvocationHandler {
+
+        private final String value;
+
+        AttributeOnlyClient(String value) {
+            this.value = value;
+        }
+
+        @Override
+        public Object invoke(Object proxy, Method method, Object[] args) {
+            String name = method.getName();
+            if ("getAttribute".equals(name) && args != null && args.length == 1 && ATTRIBUTE_KEY.equals(args[0])) {
+                return value;
+            }
+            if ("getAttributes".equals(name) && (args == null || args.length == 0)) {
+                Map<String, String> all = new HashMap<>();
+                if (value != null) {
+                    all.put(ATTRIBUTE_KEY, value);
+                }
+                return all;
+            }
+            if ("toString".equals(name)) {
+                return "ClientModel[" + ATTRIBUTE_KEY + "=" + value + "]";
+            }
+            if ("hashCode".equals(name)) {
+                return System.identityHashCode(proxy);
+            }
+            if ("equals".equals(name)) {
+                return proxy == args[0];
+            }
+            return defaultValue(method.getReturnType());
+        }
+
+        private static Object defaultValue(Class<?> type) {
+            if (!type.isPrimitive()) {
+                return null;
+            }
+            if (type == boolean.class) {
+                return Boolean.FALSE;
+            }
+            if (type == char.class) {
+                return (char) 0;
+            }
+            if (type == byte.class) {
+                return (byte) 0;
+            }
+            if (type == short.class) {
+                return (short) 0;
+            }
+            if (type == int.class) {
+                return 0;
+            }
+            if (type == long.class) {
+                return 0L;
+            }
+            if (type == float.class) {
+                return 0F;
+            }
+            if (type == double.class) {
+                return 0D;
+            }
+            return null;
+        }
+    }
