+    // ----------------------------------------------------------------------------------------------------
+    // discovery route (1) - the compiled classes of this module
+    // ----------------------------------------------------------------------------------------------------
+
+    private static List<Class<?>> newProviderClasses() {
+        List<Class<?>> discovered = new ArrayList<>();
+        for (String name : compiledClassNames()) {
+            if (BASELINE_PROVIDER_CLASS_NAMES.contains(name)) {
+                continue;
+            }
+            try {
+                Class<?> candidate = Class.forName(name, false,
+                        ClientCredentialsRefreshTokenResidualContractTest.class.getClassLoader());
+                if (ClientPolicyExecutorProvider.class.isAssignableFrom(candidate)
+                        && !candidate.isInterface()
+                        && !Modifier.isAbstract(candidate.getModifiers())
+                        && !candidate.isSynthetic()
+                        && !candidate.isAnonymousClass()) {
+                    discovered.add(candidate);
+                }
+            } catch (Throwable t) {
+                // an unloadable class must not abort the scan - it simply cannot be the executor under test
+                System.err.println("Skipping class '" + name + "' which cannot be inspected: " + t);
+            }
+        }
+        return discovered;
+    }
+
+    private static List<String> compiledClassNames() {
+        URL location = ConsentRequiredExecutor.class.getProtectionDomain().getCodeSource().getLocation();
+        Assert.assertNotNull("Cannot locate the compiled classes of the services module", location);
+
+        List<String> names = new ArrayList<>();
+        try {
+            Path root = Paths.get(location.toURI());
+            if (Files.isDirectory(root)) {
+                Path scanned = root.resolve(SCANNED_PACKAGE);
+                if (Files.isDirectory(scanned)) {
+                    try (Stream<Path> paths = Files.walk(scanned)) {
+                        names.addAll(paths
+                                .filter(path -> path.getFileName().toString().endsWith(CLASS_SUFFIX))
+                                .map(path -> toClassName(root.relativize(path).toString().replace(File.separatorChar, '/')))
+                                .collect(Collectors.toList()));
+                    }
+                }
+            } else {
+                try (JarFile jar = new JarFile(root.toFile())) {
+                    Enumeration<JarEntry> entries = jar.entries();
+                    while (entries.hasMoreElements()) {
+                        String entry = entries.nextElement().getName();
+                        if (entry.startsWith(SCANNED_PACKAGE + "/") && entry.endsWith(CLASS_SUFFIX)) {
+                            names.add(toClassName(entry));
+                        }
+                    }
+                }
+            }
+        } catch (Exception e) {
+            Assert.fail("Cannot scan the compiled classes at '" + location + "': " + e);
+        }
+        Collections.sort(names);
+        return names;
+    }
+
+    private static String toClassName(String resourcePath) {
+        return resourcePath.substring(0, resourcePath.length() - CLASS_SUFFIX.length()).replace('/', '.');
+    }
+
