+    private static List<String> newFactoryIds() {
+        List<String> ids = session().getKeycloakSessionFactory()
+                .getProviderFactoriesStream(ClientPolicyExecutorProvider.class)
+                .map(ProviderFactory::getId)
+                .filter(id -> !BASELINE_FACTORY_IDS.contains(id))
+                .sorted()
+                .collect(Collectors.toList());
+        return ids;
+    }
+
+    private static ClientPolicyExecutorProviderFactory executorProviderFactory(String id) {
+        ProviderFactory<ClientPolicyExecutorProvider> factory = session().getKeycloakSessionFactory()
+                .getProviderFactory(ClientPolicyExecutorProvider.class, id);
+        return (ClientPolicyExecutorProviderFactory) factory;
+    }
+
+    private static synchronized KeycloakSession session() {
+        if (session == null) {
+            Profile.defaults();
+            CryptoIntegration.init(CryptoProvider.class.getClassLoader());
+            ResteasyKeycloakSessionFactory sessionFactory = new ResteasyKeycloakSessionFactory();
+            sessionFactory.init();
+            session = new ResteasyKeycloakSession(sessionFactory);
+        }
+        return session;
+    }
+
+    // ----------------------------------------------------------------------------------------------------
+    // the executor under test - built without ever consulting the profile JSON
+    // ----------------------------------------------------------------------------------------------------
+
+    /**
+     * The executor as the runtime hands it to a policy: discovered by name-independent means and configured
+     * the way the shipped profile configures it. Configuring here rather than per test keeps every behaviour
+     * axis on a state the runtime can actually produce.
+     */
+    private static ClientPolicyExecutorProvider executorUnderTest() {
+        ClientPolicyExecutorProvider executor = discoverExecutor();
+        configureAsTheShippedProfileDoes(executor);
+        return executor;
+    }
+
+    private static ClientPolicyExecutorProvider discoverExecutor() {
+        List<Class<?>> discovered = newProviderClasses();
+        if (discovered.size() == 1) {
+            return instantiate(discovered.get(0));
+        }
+
+        ClientPolicyExecutorProvider fromFactory = executorFromFactory();
+        if (discovered.isEmpty()) {
+            if (fromFactory != null) {
+                return fromFactory;
+            }
+            Assert.fail("No new " + ClientPolicyExecutorProvider.class.getSimpleName() + " was found: neither a"
+                    + " new implementation compiled under " + SCANNED_PACKAGE + " nor a new provider id"
+                    + " registered through the SPI. The behaviour under test is not implemented.");
+        }
+        if (fromFactory != null && discovered.contains(fromFactory.getClass())) {
+            return fromFactory;
+        }
+        Assert.fail("Expected exactly one new " + ClientPolicyExecutorProvider.class.getSimpleName()
+                + " implementation, but found " + classNames(discovered)
+                + " and no registered factory that singles one of them out");
+        throw new AssertionError("unreachable");
+    }
+
+    private static ClientPolicyExecutorProvider executorFromFactory() {
+        try {
+            List<String> newIds = newFactoryIds();
+            if (newIds.size() != 1) {
+                return null;
+            }
+            ClientPolicyExecutorProviderFactory factory = executorProviderFactory(newIds.get(0));
+            return factory == null ? null : factory.create(session());
+        } catch (Exception e) {
+            System.err.println("Cannot build the executor through the provider SPI: " + e);
+            return null;
+        }
+    }
+
+    private static ClientPolicyExecutorProvider instantiate(Class<?> type) {
+        try {
+            for (Constructor<?> constructor : type.getConstructors()) {
+                if (constructor.getParameterCount() == 0) {
+                    return (ClientPolicyExecutorProvider) constructor.newInstance();
+                }
+            }
+            for (Constructor<?> constructor : type.getConstructors()) {
+                if (constructor.getParameterCount() == 1
+                        && constructor.getParameterTypes()[0].isAssignableFrom(KeycloakSession.class)) {
+                    return (ClientPolicyExecutorProvider) constructor.newInstance(session());
+                }
+            }
+        } catch (Exception e) {
+            Assert.fail("Cannot instantiate the discovered executor '" + type.getName() + "': " + e);
+        }
+        Assert.fail("The discovered executor '" + type.getName() + "' offers neither a public no-arg constructor"
+                + " nor a public (KeycloakSession) constructor");
+        throw new AssertionError("unreachable");
+    }
+
+    /**
+     * @return whether the {@code auto-configure} switch is expressible through the executor's own
+     * configuration type
+     */
+    private static boolean autoConfigureIsExpressible(ClientPolicyExecutorProvider executor) {
+        Class<?> configurationClass = executor.getExecutorConfigurationClass();
+        return configurationClass != null
+                && !ClientPolicyExecutorConfigurationRepresentation.class.equals(configurationClass);
+    }
+
+    /**
+     * Applies the configuration the shipped profile entry carries - {@code {"auto-configure": true}} - through
+     * the executor's own configuration type. An implementation that declares no configuration type of its own
+     * cannot express the switch; that is logged and the executor is left as it is rather than turning a
+     * behaviour axis into an error.
+     */
+    private static void configureAsTheShippedProfileDoes(ClientPolicyExecutorProvider executor) {
+        Class<?> configurationClass = executor.getExecutorConfigurationClass();
+        if (configurationClass == null) {
+            System.err.println("The executor declares no configuration class at all, so '" + AUTO_CONFIGURE
+                    + "' cannot be set up; continuing with an unconfigured executor");
+            return;
+        }
+        ObjectNode configurationNode = JsonSerialization.mapper.createObjectNode();
+        configurationNode.put(AUTO_CONFIGURE, true);
+        try {
+            ClientPolicyExecutorConfigurationRepresentation configuration =
+                    (ClientPolicyExecutorConfigurationRepresentation)
+                            JsonSerialization.mapper.convertValue(configurationNode, configurationClass);
+            executor.setupConfiguration(configuration);
+        } catch (Exception e) {
+            System.err.println("The executor configuration type '" + configurationClass.getName()
+                    + "' does not accept '" + AUTO_CONFIGURE + "' (" + e
+                    + "); continuing with an unconfigured executor");
+        }
+    }
+
+    private static List<String> classNames(List<Class<?>> classes) {
+        return classes.stream().map(Class::getName).sorted().collect(Collectors.toList());
+    }
+
+    // ----------------------------------------------------------------------------------------------------
+    // JSON helpers
+    // ----------------------------------------------------------------------------------------------------
+
+    private static List<String> executorIdsGainedByTargetProfile() throws IOException {
+        JsonNode profile = profileByName(readResource(DEFAULT_PROFILES_RESOURCE).get("profiles"), TARGET_PROFILE);
+        Assert.assertNotNull("Profile '" + TARGET_PROFILE + "' is missing from " + DEFAULT_PROFILES_RESOURCE, profile);
+
+        List<String> gained = new ArrayList<>(executorIds(profile));
+        gained.removeAll(BASELINE_TARGET_PROFILE_EXECUTOR_IDS);
+        return gained;
+    }
+
+    private static JsonNode readResource(String resource) throws IOException {
+        try (InputStream is = ClientCredentialsRefreshTokenResidualContractTest.class
+                .getClassLoader().getResourceAsStream(resource)) {
+            Assert.assertNotNull("Classpath resource '" + resource + "' is missing", is);
+            return JsonSerialization.mapper.readTree(is);
+        }
+    }
+
+    private static JsonNode profileByName(JsonNode profiles, String name) {
+        for (JsonNode profile : profiles) {
+            if (name.equals(profile.get("name").asText())) {
+                return profile;
+            }
+        }
+        return null;
+    }
+
+    private static List<String> executorIds(JsonNode profile) {
+        List<String> ids = new ArrayList<>();
+        JsonNode executors = profile.get("executors");
+        if (executors != null) {
+            for (JsonNode executor : executors) {
+                ids.add(executor.get("executor").asText());
+            }
+        }
+        return ids;
+    }
+
+    private static Set<String> referencedProfileNames(String policiesResource) throws IOException {
+        Set<String> names = new LinkedHashSet<>();
+        for (JsonNode policy : readResource(policiesResource).get("policies")) {
+            JsonNode profiles = policy.get("profiles");
+            if (profiles == null) {
+                continue;
+            }
+            for (JsonNode profile : profiles) {
+                names.add(profile.asText());
+            }
+        }
+        return names;
+    }
