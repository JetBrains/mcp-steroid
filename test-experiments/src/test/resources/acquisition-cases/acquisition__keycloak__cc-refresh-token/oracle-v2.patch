+    /**
+     * A4 - nothing else was broken: no other shipped profile gained an executor and the strict policy set still
+     * binds the target profile.
+     * <p>
+     * This axis intentionally PASSES on a pristine tree - it is a "did not break anything" check, not a
+     * "did the work" check. Note also that {@code keycloak-lax-client-policies.json} binds
+     * {@link #TARGET_PROFILE} as well, so the rule legitimately reaches the lax policy set too; only profiles
+     * OTHER than the target one are asserted about here.
+     */
+    @Test
+    public void noOtherShippedProfileGainsIt() throws IOException {
+        String gainedId = executorIdsGainedByTargetProfile().size() == 1
+                ? executorIdsGainedByTargetProfile().get(0)
+                : null;
+
+        for (JsonNode profile : readResource(DEFAULT_PROFILES_RESOURCE).get("profiles")) {
+            String name = profile.get("name").asText();
+            if (TARGET_PROFILE.equals(name)) {
+                continue;
+            }
+            List<String> baseline = BASELINE_PROFILE_EXECUTOR_IDS.get(name);
+            if (baseline == null) {
+                if (gainedId != null) {
+                    Assert.assertFalse("Profile '" + name + "' must not list the executor '" + gainedId + "'",
+                            executorIds(profile).contains(gainedId));
+                }
+                continue;
+            }
+            List<String> gained = new ArrayList<>(executorIds(profile));
+            gained.removeAll(baseline);
+            Assert.assertEquals("Profile '" + name + "' must not gain any executor, but gained " + gained,
+                    Collections.emptyList(), gained);
+        }
+
+        Assert.assertTrue(STRICT_POLICIES_RESOURCE + " must still bind the profile '" + TARGET_PROFILE + "'",
+                referencedProfileNames(STRICT_POLICIES_RESOURCE).contains(TARGET_PROFILE));
+    }
