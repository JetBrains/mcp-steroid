+package org.keycloak.protocol.oidc.grants;
+
+import jakarta.ws.rs.core.Response;
+
+import org.keycloak.OAuth2Constants;
+import org.keycloak.OAuthErrorException;
+import org.keycloak.events.Details;
+import org.keycloak.events.Errors;
+import org.keycloak.jose.jws.JWSInputException;
+import org.keycloak.services.CorsErrorResponseException;
+import org.keycloak.util.TokenUtil;
+
+/**
+ * Offline Refresh Token Grant
+ *
+ * Dedicated grant for renewing access tokens of offline sessions. Unlike the plain refresh token grant it only
+ * accepts offline refresh tokens, so that the usage of long-lived credentials can be restricted and audited
+ * separately from the renewal of the regular interactive sessions.
+ */
+public class OfflineRefreshTokenGrantType extends RefreshTokenGrantType {
+
+    public static final String OFFLINE_REFRESH_GRANT_TYPE = "urn:ietf:params:oauth:grant-type:offline-refresh";
+
+    @Override
+    public Response process(Context context) {
+        setContext(context);
+
+        String refreshToken = formParams.getFirst(OAuth2Constants.REFRESH_TOKEN);
+        if (refreshToken == null) {
+            throw new CorsErrorResponseException(cors, OAuthErrorException.INVALID_REQUEST, "No refresh token", Response.Status.BAD_REQUEST);
+        }
+
+        if (!isOfflineToken(refreshToken)) {
+            event.detail(Details.REASON, "Refresh token is not an offline token");
+            event.error(Errors.INVALID_TOKEN);
+            throw new CorsErrorResponseException(cors, OAuthErrorException.INVALID_GRANT, "Refresh token is not an offline token", Response.Status.BAD_REQUEST);
+        }
+
+        return super.process(context);
+    }
+
+    private boolean isOfflineToken(String refreshToken) {
+        try {
+            return TokenUtil.isOfflineToken(refreshToken);
+        } catch (JWSInputException e) {
+            event.detail(Details.REASON, "Unable to parse refresh token");
+            event.error(Errors.INVALID_TOKEN);
+            throw new CorsErrorResponseException(cors, OAuthErrorException.INVALID_GRANT, "Invalid refresh token", Response.Status.BAD_REQUEST);
+        }
+    }
+}
