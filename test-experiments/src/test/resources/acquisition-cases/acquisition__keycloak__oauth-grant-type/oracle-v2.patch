+     * The shipped renewal grant accepts this very token and walks straight into issuance, so this axis is
+     * exactly the delta between "copied the neighbour" and "did the work".
+     */
+    @Test
+    public void anOrdinaryInteractiveCredentialIsRefusedBeforeAnyTokenIsMinted() {
+        Outcome outcome = invokeWith(refreshTokenOfType(TokenUtil.TOKEN_TYPE_REFRESH));
