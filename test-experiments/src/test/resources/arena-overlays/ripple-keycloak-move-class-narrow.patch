+package org.keycloak.models.cache.infinispan;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Pins the moved type. The new fully-qualified name must resolve and the old one must be gone
+ * entirely: a class copied to the new package while a forwarding shell stays behind at the old
+ * location would let every caller keep resolving a name the contract no longer has, which is not a
+ * move at all. Reached by reflection and by string literal, never by import, because the type's own
+ * fully-qualified name changes across this test's before and after and an import of either name
+ * would fail to compile on the other side.
+ */
+public class MoveClassNarrowContractTest {
+
+    @Test
+    public void newFqnResolves() throws Exception {
+        Assert.assertNotNull(Class.forName("org.keycloak.models.cache.infinispan.client.ClientAdapter"));
+    }
+
+    @Test
+    public void oldFqnIsGone() {
+        try {
+            Class.forName("org.keycloak.models.cache.infinispan.ClientAdapter");
+            Assert.fail("org.keycloak.models.cache.infinispan.ClientAdapter still resolves; the move left a copy behind");
+        } catch (ClassNotFoundException expected) {
+            // the old fully-qualified name is gone, which is what this test asserts
+        }
+    }
+}
