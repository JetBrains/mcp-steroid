+package org.keycloak.userprofile;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Pins the changed signature. The new parameter list must exist and the old one must be gone
+ * entirely — an overload left behind would let every caller keep compiling against a signature the
+ * contract no longer has, which is not a signature change at all.
+ */
+public class ChangeSignatureNarrowContractTest {
+
+    /**
+     * The pre-change method name, assembled from fragments and never written as one literal.
+     *
+     * The task tells the agent that no use of the old signature may survive, so a thorough agent starts
+     * by text-searching the tree for it. This file is added by the harness, the agent is never told
+     * it exists, and editing it voids the whole run as tampering — so an old signature spelled out here
+     * would turn diligence into a disqualification, which is exactly what voided the claude+mcp arm
+     * of build 1031230755. Reflection resolves an assembled string exactly as it resolves a single
+     * literal, so nothing this test proves is weakened. Do not join these fragments back together.
+     */
+    private static String memberName() {
+        return "cont" + "ains";
+    }
+
+    @Test
+    public void newSignatureExists() throws Exception {
+        Assert.assertNotNull(Attributes.class.getMethod(memberName(), String.class, boolean.class));
+    }
+
+    @Test
+    public void oldSignatureIsGone() {
+        try {
+            Attributes.class.getMethod(memberName(), String.class);
+            Assert.fail("org.keycloak.userprofile.Attributes still declares " + memberName()
+                    + "(String); an overload is not a signature change");
+        } catch (NoSuchMethodException expected) {
+            // the old signature is gone, which is what this test asserts
+        }
+    }
+}
