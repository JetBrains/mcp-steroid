+package org.keycloak.models;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Pins the renamed user-session lookup on {@link UserSessionProvider}.
+ *
+ * The new name must be present with the same signature and return type, and the old name must be
+ * gone entirely — keeping it as a deprecated forwarder would leave every caller compiling against a
+ * name the contract this test defines no longer has.
+ */
+public class RenameMethodWideContractTest {
+
+    @Test
+    public void newNameIsDeclaredAndReturnsUserSessionModel() throws Exception {
+        Assert.assertEquals(
+                UserSessionModel.class,
+                UserSessionProvider.class
+                        .getMethod("lookupUserSession", RealmModel.class, String.class)
+                        .getReturnType());
+    }
+
+    @Test
+    public void oldNameIsGone() {
+        Assert.assertThrows(
+                "org.keycloak.models.UserSessionProvider still declares getUserSession(RealmModel, String); the rename left a compatibility alias",
+                NoSuchMethodException.class,
+                () -> UserSessionProvider.class.getMethod("getUserSession", RealmModel.class, String.class));
+    }
+}
