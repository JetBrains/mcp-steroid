+package org.keycloak.models;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Pins the renamed realm-binding method on {@link KeycloakContext}.
+ *
+ * The new name must be present with the same signature and return type, and the old name must be
+ * gone entirely — keeping it as a deprecated forwarder would leave every caller compiling against a
+ * name the contract this test defines no longer has.
+ */
+public class RenameMethodWideContractTest {
+
+    /**
+     * The pre-rename method name, assembled from fragments and never written as one literal.
+     *
+     * The task tells the agent that no use of the old name may survive, so a thorough agent starts
+     * by text-searching the tree for it. This file is added by the harness, the agent is never told
+     * it exists, and editing it voids the whole run as tampering — so an old name spelled out here
+     * would turn diligence into a disqualification, which is exactly what voided the claude+mcp arm
+     * of build 1031230755. Reflection resolves an assembled string exactly as it resolves a single
+     * literal, so nothing this test proves is weakened. Do not join these fragments back together.
+     */
+    private static String oldName() {
+        return "set" + "Realm";
+    }
+
+    @Test
+    public void newNameIsDeclaredAndReturnsVoid() throws Exception {
+        Assert.assertEquals(
+                void.class,
+                KeycloakContext.class
+                        .getMethod("bindRealm", RealmModel.class)
+                        .getReturnType());
+    }
+
+    @Test
+    public void oldNameIsGone() {
+        Assert.assertThrows(
+                "org.keycloak.models.KeycloakContext still declares " + oldName() + "(RealmModel); the rename left a compatibility alias",
+                NoSuchMethodException.class,
+                () -> KeycloakContext.class.getMethod(oldName(), RealmModel.class));
+    }
+}
